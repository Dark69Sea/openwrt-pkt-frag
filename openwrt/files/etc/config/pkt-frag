config pkt-frag 'global'
	option enabled '1'
	option frag_size '512'
	option enable_tcp '1'
	option enable_udp '1'
	option enable_tls_frag '1'
	option tls_record_size '1400'
	option enable_quic_frag '1'
	option enable_padding '1'
	option padding_min '0'
	option padding_max '64'
	option enable_fingerprint '1'
	option fingerprint_profile 'chrome'
	option rotate_interval '3600'
	option interface 'wan'